pragma solidity 0.8.28;
import {Test} from "forge-std/Test.sol";
import {MockToken} from "./AMM.t.sol";
import {Pair} from "../src/Pair.sol";

contract LPReferenceTest is Test {
    struct Case {
        uint256 a0;
        uint256 a1;
        uint256 d0;
        uint256 d1;
        uint256 supply;
        uint256 lp;
        uint256 burn0;
        uint256 burn1;
    }

    function testPythonLPIssuanceAndBurn() public {
        Case[16] memory cases = abi.decode(
            hex"",
            (Case[16])
        );
        for (uint256 i; i < 16; i++) {
            _check(cases[i]);
        }
    }

    function _check(Case memory c) private {
        MockToken x = new MockToken("X");
        MockToken y = new MockToken("Y");
        (MockToken a, MockToken b) = address(x) < address(y) ? (x, y) : (y, x);
        Pair pair = new Pair(address(a), address(b));
        a.mint(address(pair), c.a0);
        b.mint(address(pair), c.a1);
        assertEq(pair.mint(address(this)), c.supply - 1000);
        a.mint(address(pair), c.d0);
        b.mint(address(pair), c.d1);
        address bob = address(0xB0B);
        assertEq(pair.mint(bob), c.lp);
        assertEq(pair.totalSupply(), c.supply + c.lp);
        vm.prank(bob);
        pair.transfer(address(pair), c.lp);
        (uint256 out0, uint256 out1) = pair.burn(bob);
        assertEq(out0, c.burn0);
        assertEq(out1, c.burn1);
        assertEq(a.balanceOf(bob), c.burn0);
        assertEq(b.balanceOf(bob), c.burn1);
        assertEq(pair.totalSupply(), c.supply);
    }
}
